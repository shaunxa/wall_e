[Unit]
Description=Wall-E YOLO webcam web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shaun
SupplementaryGroups=bluetooth video
WorkingDirectory=/home/shaun/hello_ev3/rpi_yolo_webapp
Environment=PATH=/home/shaun/hello_ev3/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=CAMERA_INDEX=0
Environment=CAMERA_WIDTH=640
Environment=CAMERA_HEIGHT=480
ExecStart=/home/shaun/hello_ev3/.venv/bin/waitress-serve --host=0.0.0.0 --port=5000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
